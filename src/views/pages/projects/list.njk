{% extends "layouts/base.njk" %}

{% block content %}
<div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-bold text-gray-900">Projects</h1>
  <a href="/projects/new" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded transition">
    + New Project
  </a>
</div>

{% if projects.length > 0 %}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {% for project in projects %}
    <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
      <h3 class="font-semibold text-gray-900 text-lg mb-2">
        <a href="/projects/{{ project.id }}" class="hover:text-indigo-600">{{ project.name }}</a>
      </h3>
      {% if project.description %}
        <p class="text-gray-500 text-sm mb-4">{{ project.description | truncate(120) }}</p>
      {% endif %}
      <div class="flex justify-between items-center text-sm text-gray-500">
        <span>{{ project._count.tasks }} task(s)</span>
        <span>{{ project.createdAt | date("MMM D, YYYY") }}</span>
      </div>
    </div>
  {% endfor %}
  </div>
{% else %}
  <div class="bg-white rounded-lg shadow-md p-12 text-center">
    <h2 class="text-xl font-semibold text-gray-700 mb-2">No projects yet</h2>
    <p class="text-gray-500 mb-4">Create your first project to start tracking tasks.</p>
    <a href="/projects/new" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded transition">
      + New Project
    </a>
  </div>
{% endif %}
{% endblock %}
