{% extends "layouts/base.njk" %}

{% block content %}
<div class="mb-6">
  <a href="/projects" class="text-gray-500 hover:text-gray-700 text-sm">&larr; Back to Projects</a>
</div>

<div class="flex justify-between items-start mb-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">{{ project.name }}</h1>
    {% if project.description %}
      <p class="text-gray-500 mt-2">{{ project.description }}</p>
    {% endif %}
    <p class="text-xs text-gray-400 mt-2">Created {{ project.createdAt | date("MMM D, YYYY") }} by {{ project.owner.name }}</p>
  </div>
  <div class="flex gap-2">
    <button onclick="showEditProject()" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">Edit</button>
    <form action="/projects/{{ project.id }}/delete" method="POST" onsubmit="return confirm('Delete this project and all its tasks?')">
      {% include "partials/csrf-input.njk" %}
      <button type="submit" class="text-sm text-red-600 hover:text-red-800 font-medium">Delete</button>
    </form>
  </div>
</div>

<div id="edit-project-form" class="hidden mb-8 bg-white rounded-lg shadow-md p-6">
  <form action="/projects/{{ project.id }}" method="POST">
    {% include "partials/csrf-input.njk" %}
    <div class="mb-4">
      <label for="edit-name" class="block text-gray-700 text-sm font-bold mb-2">Name</label>
      <input type="text" id="edit-name" name="name" value="{{ project.name }}" required maxlength="200" class="shadow border rounded w-full py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
    </div>
    <div class="mb-4">
      <label for="edit-description" class="block text-gray-700 text-sm font-bold mb-2">Description</label>
      <textarea id="edit-description" name="description" maxlength="2000" rows="2" class="shadow border rounded w-full py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">{{ project.description }}</textarea>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold py-2 px-4 rounded">Save</button>
      <button type="button" onclick="hideEditProject()" class="text-sm text-gray-600 hover:text-gray-800 py-2 px-4">Cancel</button>
    </div>
  </form>
</div>

<div class="bg-white rounded-lg shadow-md p-6 mb-8">
  <h2 class="text-xl font-bold text-gray-900 mb-4">Add Task</h2>
  <form action="/tasks/project/{{ project.id }}/tasks" method="POST">
    {% include "partials/csrf-input.njk" %}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="md:col-span-2">
        <input type="text" name="title" placeholder="Task title" required maxlength="200" class="shadow border rounded w-full py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>
      <div>
        <select name="priority" class="shadow border rounded w-full py-2 px-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="medium">Medium</option>
          <option value="low">Low</option>
          <option value="high">High</option>
        </select>
      </div>
      <div>
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded w-full transition">Add</button>
      </div>
    </div>
  </form>
</div>

<div>
  <h2 class="text-xl font-bold text-gray-900 mb-4">Tasks</h2>
  {% if project.tasks.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {% for status in statuses %}
      <div class="bg-white rounded-lg shadow-md p-4">
        <h3 class="font-semibold text-gray-700 uppercase text-xs tracking-wider mb-3 pb-2 border-b">
          {% if status === "todo" %}Todo{% elif status === "in_progress" %}In Progress{% else %}Done{% endif %}
        </h3>
        <div class="space-y-3">
        {% for task in project.tasks %}
          {% if task.status === status %}
            <div class="bg-gray-50 rounded p-3 border border-gray-200 hover:border-indigo-300 transition">
              <div class="flex justify-between items-start mb-1">
                <h4 class="font-medium text-gray-900 text-sm">{{ task.title }}</h4>
                <span class="text-xs px-2 py-0.5 rounded-full font-medium
                  {% if task.priority === "high" %}bg-red-100 text-red-800
                  {% elif task.priority === "medium" %}bg-yellow-100 text-yellow-800
                  {% else %}bg-green-100 text-green-800{% endif %}
                ">{{ task.priority }}</span>
              </div>
              {% if task.description %}
                <p class="text-xs text-gray-500 mb-2">{{ task.description | truncate(80) }}</p>
              {% endif %}
              <div class="flex justify-between items-center text-xs mt-2">
                <div class="flex gap-1">
                  <form action="/tasks/project/{{ project.id }}/tasks/{{ task.id }}" method="POST" class="inline-flex gap-1">
                    {% include "partials/csrf-input.njk" %}
                    <input type="hidden" name="status" value="{% if status === 'todo' %}in_progress{% elif status === 'in_progress' %}done{% else %}todo{% endif %}" />
                    <button type="submit" class="text-indigo-600 hover:text-indigo-800" title="Move">
                      {% if status === "todo" %}&rarr; Progress{% elif status === "in_progress" %}&rarr; Done{% else %}&larr; Reopen{% endif %}
                    </button>
                  </form>
                </div>
                <form action="/tasks/project/{{ project.id }}/tasks/{{ task.id }}/delete" method="POST" class="inline">
                  {% include "partials/csrf-input.njk" %}
                  <button type="submit" class="text-red-500 hover:text-red-700" title="Delete">&times;</button>
                </form>
              </div>
            </div>
          {% endif %}
        {% endfor %}
        {% if status === "todo" %}
          {% set hasTodo = false %}
          {% for task in project.tasks %}{% if task.status === "todo" %}{% set hasTodo = true %}{% endif %}{% endfor %}
          {% if not hasTodo %}<p class="text-gray-400 text-sm text-center py-4">No tasks</p>{% endif %}
        {% elif status === "in_progress" %}
          {% set hasProgress = false %}
          {% for task in project.tasks %}{% if task.status === "in_progress" %}{% set hasProgress = true %}{% endif %}{% endfor %}
          {% if not hasProgress %}<p class="text-gray-400 text-sm text-center py-4">No tasks</p>{% endif %}
        {% else %}
          {% set hasDone = false %}
          {% for task in project.tasks %}{% if task.status === "done" %}{% set hasDone = true %}{% endif %}{% endfor %}
          {% if not hasDone %}<p class="text-gray-400 text-sm text-center py-4">No tasks</p>{% endif %}
        {% endif %}
        </div>
      </div>
    {% endfor %}
    </div>
  {% else %}
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <p class="text-gray-500">No tasks yet. Add one above!</p>
    </div>
  {% endif %}
</div>

<script>
function showEditProject() {
  document.getElementById('edit-project-form').classList.remove('hidden');
}
function hideEditProject() {
  document.getElementById('edit-project-form').classList.add('hidden');
}
</script>
{% endblock %}
