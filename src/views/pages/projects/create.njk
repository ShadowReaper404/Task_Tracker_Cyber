{% extends "layouts/base.njk" %}

{% block content %}
<div class="max-w-2xl mx-auto mt-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">New Project</h1>

  <form action="/projects" method="POST" class="bg-white shadow-md rounded-lg px-8 pt-6 pb-8">
    {% include "partials/csrf-input.njk" %}

    <div class="mb-4">
      <label for="name" class="block text-gray-700 text-sm font-bold mb-2">Project Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="{{ form.name }}"
        required
        maxlength="200"
        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
        autofocus
      />
    </div>

    <div class="mb-6">
      <label for="description" class="block text-gray-700 text-sm font-bold mb-2">Description</label>
      <textarea
        id="description"
        name="description"
        maxlength="2000"
        rows="3"
        class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
      >{{ form.description }}</textarea>
    </div>

    <div class="flex items-center gap-4">
      <button
        type="submit"
        class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
      >
        Create Project
      </button>
      <a href="/projects" class="text-gray-600 hover:text-gray-800">Cancel</a>
    </div>
  </form>
</div>
{% endblock %}
